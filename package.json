{
  "name": "trick-or-treat-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "pack": "npm run build && node tools/pack.mjs",
    "clips": "node tools/make-clips.mjs",
    "test": "node tests/run.mjs",
    "test:e2e": "node tests/run.mjs --e2e",
