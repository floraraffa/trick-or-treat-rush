    "textures": "node tools/fetch-textures.mjs",
    "creatures": "node tools/make-creatures.mjs"
  },
  "dependencies": {
    "@snap/web-lens-api": "^0.1.2",
    "playcanvas": "^2.23.2"
  },
  "devDependencies": {
    "@fontsource/griffy": "^5.3.0",
    "@fontsource/mystery-quest": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "archiver": "^7.0.1",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.34.4",
    "vite": "^6.3.0"
  }
